  {
    "id": "fn_read_cv4g",
    "type": "function",
    "z": "tab_cv4g",
    "name": "Processar leitura + gráfico + MySQL",
    "func": "let d = msg.payload;\n\nif (typeof d === \"string\") {\n    try { d = JSON.parse(d); }\n    catch(e) {\n        node.warn(\"JSON inválido: \" + msg.payload);\n        return [null,null,null,null,null,null,null,null];\n    }\n}\n\nconst v = Number(d.potential_est_mv);\nconst i = Number(d.current_nA);\n\nif (!Number.isFinite(v) || !Number.isFinite(i)) {\n    node.warn(\"Leitura inválida: \" + JSON.stringify(d));\n    return [null,null,null,null,null,null,null,null];\n}\n\nlet pts = flow.get(\"chart_points\") || [];\n\npts.push({\n    series:\"Ciclo \" + Number(d.cycle || 1),\n    x:v,\n    y:i\n});\n\nif (pts.length > 12000)\n    pts = pts.slice(-12000);\n\nflow.set(\"chart_points\", pts);\n\nconst chart = {\n    payload:pts,\n    action:\"replace\"\n};\n\nconst potential = {payload:v.toFixed(2)};\nconst current   = {payload:i.toFixed(3)};\nconst ads       = {payload:Number(d.ads_v).toFixed(5)};\nconst gain      = {payload:d.gain};\nconst cycle     = {payload:d.cycle};\nconst quality   = {payload:`${d.quality} | σ=${Number(d.adc_raw_std).toFixed(1)} RAW`};\n\nlet db = null;\n\nif (flow.get(\"save_mysql\") !== false) {\n    db = {\n        topic:`INSERT INTO cv_samples\n        (run_id,sample_index,elapsed_ms,cycle_no,segment_id,segment_name,\n         potential_set_mv,potential_est_mv,dac_raw,gain_no,rtia_nominal_ohm,\n         adc_raw_mean,adc_raw_min,adc_raw_max,adc_raw_std,ads_v,\n         current_na,current_ua,quality,rssi_dbm)\n         VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,\n        payload:[\n            d.run_id,\n            d.sample_index,\n            d.elapsed_ms,\n            d.cycle,\n            d.segment_id,\n            d.segment,\n            d.potential_set_mv,\n            d.potential_est_mv,\n            d.dac_raw,\n            d.gain,\n            d.rtia_nominal_ohm,\n            d.adc_raw_mean,\n            d.adc_raw_min,\n            d.adc_raw_max,\n            d.adc_raw_std,\n            d.ads_v,\n            d.current_nA,\n            d.current_uA,\n            d.quality,\n            d.rssi_dbm\n        ]\n    };\n}\n\nreturn [\n    chart,\n    potential,\n    current,\n    ads,\n    gain,\n    cycle,\n    quality,\n    db\n];",
    "outputs": 8,
    "x": 400,
    "y": 540,
