  {
    "id": "fn_start_cv4g",
    "type": "function",
    "z": "tab_cv4g",
    "name": "Validar + START + sessão MySQL",
    "func": "const f = msg.payload || {};\nconst gain = Number(flow.get(\"cv_gain\") ?? 2);\nconst save = flow.get(\"save_mysql\") !== false;\n\nconst ranges = {\n    0:{min:-859,max:1137},\n    1:{min:-1272,max:2935},\n    2:{min:-2499,max:2938},\n    3:{min:-2499,max:2939}\n};\n\nconst p = {\n    sample_name: String(f.sample_name || \"Amostra\"),\n    notes: String(f.notes || \"\"),\n    vStart_mv: Number(f.vStart_mv),\n    vVertex1_mv: Number(f.vVertex1_mv),\n    vVertex2_mv: Number(f.vVertex2_mv),\n    vEnd_mv: Number(f.vEnd_mv),\n    step_mv: Number(f.step_mv),\n    scan_rate_mv_s: Number(f.scan_rate_mv_s),\n    cycles: Number(f.cycles),\n    quiet_time_ms: Number(f.quiet_time_ms),\n    sample_interval_ms: Number(f.sample_interval_ms),\n    settle_ms: Number(f.settle_ms),\n    adc_samples: Number(f.adc_samples),\n    gain: gain\n};\n\nfor (const [k,v] of Object.entries(p)) {\n    if (typeof v === \"number\" && !Number.isFinite(v)) {\n        node.error(\"Valor inválido em \" + k);\n        return [null,null,null];\n    }\n}\n\nif (p.step_mv <= 0 || p.scan_rate_mv_s <= 0 || p.cycles < 1) {\n    node.error(\"step, scan rate e cycles devem ser maiores que zero.\");\n    return [null,null,null];\n}\n\nconst r = ranges[gain];\nfor (const key of [\"vStart_mv\",\"vVertex1_mv\",\"vVertex2_mv\",\"vEnd_mv\"]) {\n    if (p[key] < r.min || p[key] > r.max) {\n        node.error(`${key}=${p[key]} mV está fora da faixa validada do ganho ${gain}: ${r.min} a ${r.max} mV`);\n        return [null,null,null];\n    }\n}\n\n// ID simples e rastreável\nconst runId =\n    \"CV-\" +\n    Date.now().toString(36).toUpperCase() +\n    \"-\" +\n    Math.floor(Math.random()*0xFFFF).toString(16).toUpperCase().padStart(4,\"0\");\n\nflow.set(\"current_run_id\", runId);\nflow.set(\"chart_points\", []);\n\nconst command = {\n    cmd:\"START\",\n    run_id:runId,\n    vStart_mv:p.vStart_mv,\n    vVertex1_mv:p.vVertex1_mv,\n    vVertex2_mv:p.vVertex2_mv,\n    vEnd_mv:p.vEnd_mv,\n    step_mv:p.step_mv,\n    scan_rate_mv_s:p.scan_rate_mv_s,\n    cycles:p.cycles,\n    quiet_time_ms:p.quiet_time_ms,\n    sample_interval_ms:p.sample_interval_ms,\n    settle_ms:p.settle_ms,\n    adc_samples:p.adc_samples,\n    gain:p.gain\n};\n\nconst mqtt = {\n    topic:\"ic/potenciostato/comando\",\n    payload:JSON.stringify(command),\n    qos:0,\n    retain:false\n};\n\nconst clear = {\n    payload:[],\n    action:\"replace\"\n};\n\nlet db = null;\n\nif (save) {\n    db = {\n        topic:`INSERT INTO cv_runs\n        (run_id,nome_amostra,observacoes,v_start_mv,v_vertex1_mv,v_vertex2_mv,v_end_mv,\n         step_mv,scan_rate_mv_s,cycles,gain_initial,quiet_time_ms,sample_interval_ms,\n         settle_ms,adc_samples,status)\n        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,\n        payload:[\n            runId,p.sample_name,p.notes,\n            p.vStart_mv,p.vVertex1_mv,p.vVertex2_mv,p.vEnd_mv,\n            p.step_mv,p.scan_rate_mv_s,p.cycles,p.gain,\n            p.quiet_time_ms,p.sample_interval_ms,p.settle_ms,p.adc_samples,\n            \"starting\"\n        ]\n    };\n}\n\nreturn [mqtt, clear, db];",
    "outputs": 3,
    "x": 450,
    "y": 120,
    "wires": [
      [
        "mqtt_out_cv4g"
      ],
      [
        "chart_cv4g"
      ],
      [
        "mysql_run_cv4g"
      ]
    ]
