    "id": "fn_gain_cv4g",
    "type": "function",
    "z": "tab_cv4g",
    "name": "Guardar ganho / informar faixa",
    "func": "const g = Number(msg.payload);\nflow.set(\"cv_gain\", g);\n\nconst ranges = {\n  0: \"G0: -859 a +1137 mV | aproximadamente -60,9 a +80,6 nA | máxima sensibilidade\",\n  1: \"G1: -1272 a +2935 mV | aproximadamente -135 a +311 nA | maiores correntes\",\n  2: \"G2: -2499 a +2938 mV | aproximadamente -265 a +312 nA | uso geral\",\n  3: \"G3: -2499 a +2939 mV | aproximadamente -265 a +312 nA | alta sensibilidade\"\n};\n\nreturn {payload:ranges[g] || \"Ganho inválido\"};",
    "outputs": 1,
    "x": 430,
    "y": 210,
    "wires": [
