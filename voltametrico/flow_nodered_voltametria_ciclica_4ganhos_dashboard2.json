  {
    "id": "fn_status_cv4g",
    "type": "function",
    "z": "tab_cv4g",
    "name": "Interpretar status + finalizar sessão",
    "func": "let d = msg.payload;\n\nif (typeof d === \"string\") {\n    try { d = JSON.parse(d); }\n    catch(e) { d = {status:String(msg.payload), detail:\"\"}; }\n}\n\nconst s = String(d.status || d.state || \"unknown\");\nconst detail = String(d.detail || \"\");\n\nlet color = \"#607D8B\";\nif (s === \"running\") color = \"#2E7D32\";\nelse if (s === \"quiet\") color = \"#FB8C00\";\nelse if (s === \"completed\") color = \"#1565C0\";\nelse if (s === \"aborted\" || s.startsWith(\"error\")) color = \"#C62828\";\n\nconst ui = {\n    payload:{\n        status:s,\n        detail:detail,\n        color:color,\n        cycle:d.cycle,\n        sample_index:d.sample_index,\n        point_period_ms:d.point_period_ms\n    }\n};\n\nlet db = null;\nconst save = flow.get(\"save_mysql\") !== false;\nconst runId = d.run_id || flow.get(\"current_run_id\");\n\nif (save && runId && [\"completed\",\"aborted\",\"error_config\",\"error_json\"].includes(s)) {\n    db = {\n        topic:\"UPDATE cv_runs SET status=?, finished_at=NOW(3) WHERE run_id=?\",\n        payload:[s,runId]\n    };\n}\nelse if (save && runId && [\"running\",\"quiet\"].includes(s)) {\n    db = {\n        topic:\"UPDATE cv_runs SET status=? WHERE run_id=?\",\n        payload:[s,runId]\n    };\n}\n\nreturn [ui, db];",
    "outputs": 2,
    "x": 430,
    "y": 410,
    "wires": [
      [
        "tpl_status_cv4g",
        "txt_status_cv4g"
      ],
      [
        "mysql_run_cv4g"
      ]
    ]
  },
