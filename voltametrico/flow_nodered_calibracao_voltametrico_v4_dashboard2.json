  {
    "id": "fn_send_raw_v4",
    "type": "function",
    "z": "flow_cal_v4",
    "name": "Enviar DAC RAW",
    "func": "const raw = Math.max(0, Math.min(4095, Math.round(Number(msg.payload))));\nflow.set(\"dac_raw\", raw);\nconst gain = flow.get(\"gain\") ?? 0;\n\nmsg.topic = \"ic/potenciostato/calibracao/comando\";\nmsg.payload = JSON.stringify({cmd:\"SET_RAW\", dac_raw:raw, gain:Number(gain)});\nmsg.qos = 0;\nmsg.retain = false;\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 100,
    "wires": [
      [
        "mqtt_out_cal_v4"
      ]
    ]
  },
  {
    "id": "fn_send_gain_v4",
    "type": "function",
    "z": "flow_cal_v4",
    "name": "Enviar ganho",
    "func": "const gain = Number(msg.payload);\nflow.set(\"gain\", gain);\nconst raw = flow.get(\"dac_raw\") ?? 2048;\n\nmsg.topic = \"ic/potenciostato/calibracao/comando\";\nmsg.payload = JSON.stringify({cmd:\"SET_RAW\", dac_raw:Number(raw), gain:gain});\nmsg.qos = 0;\nmsg.retain = false;\nreturn msg;",
    "outputs": 1,
    "x": 390,
    "y": 150,
    "wires": [
      [
        "mqtt_out_cal_v4"
      ]
    ]
  },
