  {
    "id": "fn_parse_cal_v4",
    "type": "function",
    "z": "flow_cal_v4",
    "name": "Separar telemetria",
    "func": "let d = msg.payload;\nif (typeof d === \"string\") {\n    try { d = JSON.parse(d); }\n    catch(e) { node.warn(\"JSON inválido: \" + msg.payload); return [null,null,null,null,null,null,null,null]; }\n}\n\nflow.set(\"latest_telemetry\", d);\n\nreturn [\n    {payload:d.dac_raw},\n    {payload:Number(d.dac_v_theory).toFixed(6)},\n    {payload:Number(d.adc_raw_mean).toFixed(2)},\n    {payload:d.adc_raw_min},\n    {payload:d.adc_raw_max},\n    {payload:Number(d.adc_raw_std).toFixed(2)},\n    {payload:Number(d.adc_v).toFixed(6)},\n    {payload:Math.round(Number(d.rtia_ohm))}\n];",
    "outputs": 8,
    "x": 410,
    "y": 410,
    "wires": [
      [
        "txt_dacraw_cal_v4"
      ],
      [
        "txt_dacv_cal_v4"
      ],
      [
        "txt_adcmean_cal_v4"
      ],
      [
        "txt_adcmin_cal_v4"
      ],
      [
        "txt_adcmax_cal_v4"
      ],
      [
        "txt_adcstd_cal_v4"
      ],
      [
        "txt_adcv_cal_v4"
      ],
      [
        "txt_rtia_cal_v4"
      ]
    ]
  },
