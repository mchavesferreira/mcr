    "z": "flow_cal_v4",
    "name": "Registrar + regressões",
    "func": "const d = flow.get(\"latest_telemetry\");\nif (!d) {\n    node.warn(\"Ainda não há telemetria do ESP32.\");\n    return [null,null,null];\n}\n\nconst load_mv = Number(msg.payload?.load_mv);\nconst ads_input_v = Number(msg.payload?.ads_input_v);\nconst rcell = Number(flow.get(\"rcell_ohm\") ?? 9426000);\n\nif (!Number.isFinite(load_mv) || !Number.isFinite(ads_input_v) || !(rcell > 0)) {\n    node.warn(\"Medidas ou resistência inválidas.\");\n    return [null,null,null];\n}\n\n// Corrente conhecida pela carga resistiva.\n// nA = (mV/1000)/R * 1e9\nconst current_nA = (load_mv * 1e6) / rcell;\n\nconst rec = {\n    timestamp: Date.now(),\n    dac_raw: Number(d.dac_raw),\n    dac_v_theory: Number(d.dac_v_theory),\n\n    load_mv: load_mv,\n    rcell_ohm: rcell,\n    current_theory_nA: current_nA,\n\n    ads_input_v: ads_input_v,\n    adc_raw_mean: Number(d.adc_raw_mean),\n    adc_raw_min: Number(d.adc_raw_min),\n    adc_raw_max: Number(d.adc_raw_max),\n    adc_raw_std: Number(d.adc_raw_std),\n    adc_v_firmware: Number(d.adc_v),\n\n    gain: Number(d.gain),\n    rtia_ohm: Number(d.rtia_ohm)\n};\n\nlet pts = flow.get(\"calibration_points\") || [];\npts.push(rec);\nflow.set(\"calibration_points\", pts);\n\nfunction linreg(arr, xkey, ykey) {\n    const valid = arr.filter(p => Number.isFinite(Number(p[xkey])) && Number.isFinite(Number(p[ykey])));\n    const n = valid.length;\n    if (n < 2) return null;\n\n    let sx=0, sy=0, sxx=0, sxy=0;\n    for (const p of valid) {\n        const x=Number(p[xkey]), y=Number(p[ykey]);\n        sx += x; sy += y; sxx += x*x; sxy += x*y;\n    }\n\n    const den = n*sxx - sx*sx;\n    if (Math.abs(den) < 1e-18) return null;\n\n    const a = (n*sxy - sx*sy) / den;\n    const b = (sy - a*sx) / n;\n    const ybar = sy/n;\n\n    let ssres=0, sstot=0;\n    for (const p of valid) {\n        const x=Number(p[xkey]), y=Number(p[ykey]);\n        const yh=a*x+b;\n        ssres += (y-yh)*(y-yh);\n        sstot += (y-ybar)*(y-ybar);\n    }\n\n    const r2 = sstot > 0 ? 1 - ssres/sstot : 1;\n    return {n,a,b,r2};\n}\n\n// 1) calibração do caminho de saída: mV carga = a * DAC_RAW + b\nconst fitDAC = linreg(pts, \"dac_raw\", \"load_mv\");\n\n// 2) calibração do próprio ADC: V externo = a * ADC_RAW + b\nconst fitADC = linreg(pts, \"adc_raw_mean\", \"ads_input_v\");\n\n// Corrente é dependente do ganho do TIA.\n// Regressões abaixo usam somente os pontos do ganho atual.\nconst gainPts = pts.filter(p => Number(p.gain) === Number(rec.gain));\n\n// 3) corrente teórica versus tensão analógica que realmente entra no ADS1115\nconst fitIV = linreg(gainPts, \"ads_input_v\", \"current_theory_nA\");\n\n// 4) calibração direta para firmware: corrente teórica versus ADC RAW\nconst fitIRaw = linreg(gainPts, \"adc_raw_mean\", \"current_theory_nA\");\n\nconst summary = {\n    total_points: pts.length,\n    gain: rec.gain,\n    gain_points: gainPts.length,\n\n    dac_voltage_fit: fitDAC,\n    adc_voltage_fit: fitADC,\n    current_vs_ads_voltage_fit: fitIV,\n    current_vs_adc_raw_fit: fitIRaw\n};\n\nflow.set(\"calibration_summary\", summary);\n\nlet text = \"\";\nif (fitDAC) {\n    text += `DAC -> carga: Vload_mV = ${fitDAC.a.toFixed(6)}*DACraw + ${fitDAC.b.toFixed(3)}   R²=${fitDAC.r2.toFixed(6)}   n=${fitDAC.n}\\n`;\n    if (Math.abs(fitDAC.a) > 1e-12) {\n        text += `RAW estimado para Vload=0: ${(-fitDAC.b/fitDAC.a).toFixed(2)}\\n`;\n    }\n}\nif (fitADC) {\n    text += `ADC -> Ventrada: Vads = ${fitADC.a.toExponential(8)}*ADCraw + ${fitADC.b.toFixed(6)}   R²=${fitADC.r2.toFixed(6)}   n=${fitADC.n}\\n`;\n}\nif (fitIV) {\n    text += `Ganho ${rec.gain}: I_nA = ${fitIV.a.toFixed(6)}*Vads + ${fitIV.b.toFixed(6)}   R²=${fitIV.r2.toFixed(6)}   n=${fitIV.n}\\n`;\n}\nif (fitIRaw) {\n    text += `Ganho ${rec.gain}: I_nA = ${fitIRaw.a.toExponential(8)}*ADCraw + ${fitIRaw.b.toFixed(6)}   R²=${fitIRaw.r2.toFixed(6)}   n=${fitIRaw.n}`;\n}\n\nreturn [\n    {payload:rec},\n    {payload:text || \"São necessários pelo menos 2 pontos para a regressão.\"},\n    {payload:JSON.stringify(rec)}\n];",
