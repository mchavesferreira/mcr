    "type": "function",
    "z": "flow_cal_v4",
    "name": "Guardar R carga",
    "func": "const mohm = Number(msg.payload?.rcell_mohm);\nif (!Number.isFinite(mohm) || mohm <= 0) {\n    node.warn(\"R da carga inválida.\");\n    return null;\n}\nflow.set(\"rcell_ohm\", mohm * 1e6);\nmsg.payload = mohm.toFixed(6) + \" MΩ\";\nreturn msg;",
